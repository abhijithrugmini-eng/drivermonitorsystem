  <!-- PAGE 2: VIOLATION & EVIDENCE DATA MODELS -->
  <diagram id="violation-evidence-models" name="Violation & Evidence Models">
    <mxGraphModel dx="1256" dy="611" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1200" pageHeight="800" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <!-- PAGE TITLE -->
        <mxCell id="page2-title" parent="1" style="text;fontSize=16;fontStyle=1;align=center;fillColor=#e3f2fd;strokeColor=#1565c0;rounded=1;padding=10" value="VIOLATION & EVIDENCE DATA MODELS (POC)" vertex="1">
          <mxGeometry height="35" width="1100" x="50" y="10" as="geometry" />
        </mxCell>

        <!-- SECTION 1: EVENT MODEL -->
        <mxCell id="event-section" parent="1" style="text;fontSize=12;fontStyle=1;align=left;fillColor=#bbdefb;strokeColor=#1976d2;rounded=1;padding=8" value="1. EVENT MODEL (Edge → Server)" vertex="1">
          <mxGeometry height="28" width="350" x="50" y="60" as="geometry" />
        </mxCell>

        <mxCell id="event-details" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e3f2fd;strokeColor=#1976d2;fontSize=9;align=left;padding=8;fontFamily=monospace" value="Event JSON (from DMS):&#xa;{&#xa;  event_id: &quot;evt_001&quot;,&#xa;  timestamp: 1722638401.23,&#xa;  type: &quot;DROWSINESS&quot;,&#xa;  confidence: 0.95,&#xa;  metrics: {&#xa;    ear: 0.18,&#xa;    duration_seconds: 0.75,&#xa;    blink_rate: 8.5&#xa;  },&#xa;  trip_context: { trip_id: &quot;trip_001&quot; },&#xa;  vehicle_context: { speed_kmh: 80.5 }&#xa;}" vertex="1">
          <mxGeometry height="180" width="350" x="50" y="95" as="geometry" />
        </mxCell>

        <mxCell id="event-storage" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff9c4;strokeColor=#f57f17;fontSize=9;align=left;padding=8" value="Storage:&#xa;logs/events.jsonl&#xa;(one per line)&#xa;&#xa;Frequency:&#xa;1-5 per minute&#xa;during demo" vertex="1">
          <mxGeometry height="100" width="200" x="420" y="95" as="geometry" />
        </mxCell>

        <!-- SECTION 2: VIOLATION MODEL -->
        <mxCell id="violation-section" parent="1" style="text;fontSize=12;fontStyle=1;align=left;fillColor=#f3e5f5;strokeColor=#7b1fa2;rounded=1;padding=8" value="2. VIOLATION MODEL (Server → Dashboard)" vertex="1">
          <mxGeometry height="28" width="350" x="50" y="290" as="geometry" />
        </mxCell>

        <mxCell id="violation-details" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f3e5f5;strokeColor=#7b1fa2;fontSize=9;align=left;padding=8;fontFamily=monospace" value="Violation JSON (aggregated):&#xa;{&#xa;  violation_id: &quot;viol_001&quot;,&#xa;  violation_type: &quot;DROWSINESS_PATTERN&quot;,&#xa;  severity: &quot;CRITICAL&quot;,&#xa;  evidence: {&#xa;    event_count: 3,&#xa;    events: [...],&#xa;    first_frame_jpg: &quot;data:image/jpeg;base64,...&quot;&#xa;  },&#xa;  alarm_message: &quot;⚠️ DROWSINESS DETECTED&quot;,&#xa;  timestamp: 1722638401.24&#xa;}" vertex="1">
          <mxGeometry height="200" width="350" x="50" y="325" as="geometry" />
        </mxCell>

        <mxCell id="violation-storage" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff9c4;strokeColor=#f57f17;fontSize=9;align=left;padding=8" value="Storage:&#xa;logs/violations.jsonl&#xa;(one per line)&#xa;&#xa;Frequency:&#xa;1-2 per minute&#xa;during demo&#xa;&#xa;Broadcast:&#xa;WebSocket" vertex="1">
          <mxGeometry height="100" width="200" x="420" y="325" as="geometry" />
        </mxCell>

        <!-- SECTION 3: EVIDENCE MODEL -->
        <mxCell id="evidence-section" parent="1" style="text;fontSize=12;fontStyle=1;align=left;fillColor=#c8e6c9;strokeColor=#1b5e20;rounded=1;padding=8" value="3. EVIDENCE MODEL (JPG Capture)" vertex="1">
          <mxGeometry height="28" width="350" x="680" y="60" as="geometry" />
        </mxCell>

        <mxCell id="evidence-details" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#c8e6c9;strokeColor=#1b5e20;fontSize=9;align=left;padding=8" value="Evidence Capture (POC):&#xa;&#xa;● When: At violation trigger moment&#xa;● Source: First frame when rule fired&#xa;● Format: Base64 JPEG&#xa;● Size: ~40-60 KB per image&#xa;● Location: Embedded in violation.evidence.first_frame_jpg&#xa;&#xa;Display:&#xa;● Dashboard shows JPG in violation card&#xa;● Size on dashboard: 300px max-width&#xa;● Proof of behavior" vertex="1">
          <mxGeometry height="180" width="350" x="680" y="95" as="geometry" />
        </mxCell>

        <!-- SECTION 4: VIOLATION RULES -->
        <mxCell id="rules-section" parent="1" style="text;fontSize=12;fontStyle=1;align=left;fillColor=#ffe0b2;strokeColor=#e65100;rounded=1;padding=8" value="4. VIOLATION RULES (Trigger Conditions)" vertex="1">
          <mxGeometry height="28" width="350" x="680" y="290" as="geometry" />
        </mxCell>

        <mxCell id="rule-detail" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe0b2;strokeColor=#e65100;fontSize=8;align=left;padding=8" value="Rule 1: DROWSINESS_PATTERN&#xa;├─ Trigger: 3+ DROWSINESS events in 2 min&#xa;├─ Severity: CRITICAL (RED)&#xa;└─ Evidence: 3 events + first JPG&#xa;&#xa;Rule 2: PHONE_USAGE&#xa;├─ Trigger: 1+ PHONE event (conf &gt; 0.85)&#xa;├─ Severity: HIGH (ORANGE)&#xa;└─ Evidence: 1 event + JPG&#xa;&#xa;Rule 3: DISTRACTION_PATTERN&#xa;├─ Trigger: 2+ DISTRACTION in 1 min&#xa;├─ Severity: MEDIUM (YELLOW)&#xa;└─ Evidence: 2+ events + JPG&#xa;&#xa;Rule 4: CONTINUOUS_DRIVE&#xa;├─ Trigger: Driving &gt; 4 hours&#xa;├─ Severity: LOW (BLUE)&#xa;└─ Evidence: Trip duration" vertex="1">
          <mxGeometry height="220" width="350" x="680" y="325" as="geometry" />
        </mxCell>

        <!-- FLOW ARROWS -->
        <mxCell id="flow1" edge="1" parent="1" source="event-details" target="violation-details" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#666;strokeWidth=2;dashed=0">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="225" y="285" />
              <mxPoint x="225" y="310" />
            </Array>
          </mxGeometry>
        </mxCell>

        <mxCell id="flow-label" parent="1" style="text;fontSize=9;fontStyle=1;align=center;fillColor=#fff9c4;strokeColor=#f57f17" value="Aggregation&#xa;(3 events→1 violation)" vertex="1">
          <mxGeometry height="40" width="100" x="175" y="275" as="geometry" />
        </mxCell>

        <!-- BOTTOM SUMMARY -->
        <mxCell id="summary" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#424242;fontSize=9;align=left;padding=10" value="KEY POINTS:&#xa;• Events: Raw detections from DMS (frequent, high volume)&#xa;• Violations: Aggregated alerts based on rules (less frequent, actionable)&#xa;• Evidence: JPG snapshot at violation moment (for accountability)&#xa;• All stored in JSON (JSONL for streaming, in-memory during processing)&#xa;• Broadcast to dashboard via WebSocket in real-time" vertex="1">
          <mxGeometry height="100" width="1100" x="50" y="680" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>

  <!-- PAGE 3: EDGE-SIDE VIOLATION ENGINE FLOW -->
  <diagram id="edge-violation-engine" name="Edge-Side Violation Engine (When & Where)">
    <mxGraphModel dx="1256" dy="611" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1200" pageHeight="800" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <!-- PAGE TITLE -->
        <mxCell id="page3-title" parent="1" style="text;fontSize=16;fontStyle=1;align=center;fillColor=#fff3e0;strokeColor=#e65100;rounded=1;padding=10" value="EDGE-SIDE VIOLATION ENGINE: When & Where Models Are Created" vertex="1">
          <mxGeometry height="35" width="1100" x="50" y="10" as="geometry" />
        </mxCell>

        <!-- CONTEXT: ARCHITECTURE CHOICE -->
        <mxCell id="context-box" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f3e5f5;strokeColor=#7b1fa2;fontSize=9;align=left;padding=10" value="CONTEXT: POC Currently Uses SERVER-Side Violation Detection&#xa;&#xa;Current Flow (Recommended for POC):&#xa;DMS (Edge) → Emit Events → POST /events → Server Violation Engine&#xa;&#xa;This page explains the ALTERNATIVE: Edge-Side Violation Engine&#xa;(For future Phase 2+ scaling to distributed edge devices)" vertex="1">
          <mxGeometry height="90" width="1100" x="50" y="60" as="geometry" />
        </mxCell>

        <!-- TIMELINE: WHERE MODELS ARE CREATED -->
        <mxCell id="timeline-label" parent="1" style="text;fontSize=12;fontStyle=1;align=left;fillColor=#bbdefb;strokeColor=#1976d2;rounded=1;padding=8" value="TIMELINE: Model Creation Points on Edge" vertex="1">
          <mxGeometry height="28" width="400" x="50" y="165" as="geometry" />
        </mxCell>

        <!-- STEP 1: FRAME CAPTURE -->
        <mxCell id="step1-box" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e3f2fd;strokeColor=#1976d2;fontSize=9;align=left;padding=8" value="STEP 1: Frame Capture (DMS)&#xa;&#xa;WHEN: Every frame (~30 FPS)&#xa;WHERE: dms.py:process_frame()&#xa;&#xa;What happens:&#xa;├─ Read frame from video/camera&#xa;└─ Store current_frame in memory&#xa;   (needed for JPG evidence later)" vertex="1">
          <mxGeometry height="110" width="280" x="50" y="210" as="geometry" />
        </mxCell>

        <!-- STEP 2: DETECTION -->
        <mxCell id="step2-box" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e3f2fd;strokeColor=#1976d2;fontSize=9;align=left;padding=8" value="STEP 2: Detection (YOLO + MediaPipe)&#xa;&#xa;WHEN: Every frame&#xa;WHERE: dms.py:detect_behaviors()&#xa;&#xa;What happens:&#xa;├─ Run YOLO (every 3rd frame)&#xa;├─ Run MediaPipe (every frame)&#xa;└─ Compute metrics (EAR, MAR, etc.)" vertex="1">
          <mxGeometry height="110" width="280" x="50" y="335" as="geometry" />
        </mxCell>

        <!-- STEP 3: THRESHOLD CHECK + EVENT EMIT -->
        <mxCell id="step3-box" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#c8e6c9;strokeColor=#1b5e20;fontSize=9;align=left;padding=8" value="STEP 3: Threshold Check → Event&#xa;&#xa;WHEN: Every frame (thresholds trigger ~1-5/min)&#xa;WHERE: dms.py:_emit_event()&#xa;&#xa;Models created:&#xa;✅ EVENT model (see page 2)&#xa;└─ Contains: type, EAR, duration, timestamp&#xa;└─ Stored: logs/events.jsonl&#xa;└─ Sent: POST /events → server" vertex="1">
          <mxGeometry height="130" width="280" x="50" y="460" as="geometry" />
        </mxCell>

        <!-- DECISION POINT: EDGE VS SERVER -->
        <mxCell id="decision-label" parent="1" style="text;fontSize=12;fontStyle=1;align=left;fillColor=#ffe0b2;strokeColor=#e65100;rounded=1;padding=8" value="DECISION POINT: Where Should Violation Detection Happen?" vertex="1">
          <mxGeometry height="28" width="500" x="380" y="210" as="geometry" />
        </mxCell>

        <!-- OPTION A: EDGE VIOLATION ENGINE -->
        <mxCell id="option-a-title" parent="1" style="text;fontSize=11;fontStyle=1;align=left;fillColor=#ffccbc;strokeColor=#bf360c;rounded=1;padding=8" value="OPTION A: Edge-Side Violation Engine" vertex="1">
          <mxGeometry height="25" width="380" x="380" y="250" as="geometry" />
        </mxCell>

        <mxCell id="option-a-box" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffebee;strokeColor=#bf360c;fontSize=8;align=left;padding=8" value="WHEN: Each event is emitted (1-5 per minute)&#xa;WHERE: dms.py:check_violation_rules() (on edge device)&#xa;&#xa;Models created on EDGE:&#xa;✅ VIOLATION model (aggregated)&#xa;   └─ Count events: 3 drowsy in 2 min?&#xa;   └─ Trigger rule, create violation&#xa;✅ EVIDENCE model (JPG capture)&#xa;   └─ Store current_frame as JPG base64&#xa;   └─ Embed in violation object&#xa;✅ ALARM model&#xa;   └─ Create message: &quot;DROWSINESS DETECTED&quot;&#xa;&#xa;Flow on Edge:&#xa;Event → Rule Check → Violation (+ JPG) → Alarm&#xa;  ↓&#xa;  POST /violations → Server&#xa;  ↓&#xa;  Server broadcasts to Dashboard&#xa;&#xa;Pros:&#xa;✓ Low latency (no server round-trip)&#xa;✓ Works offline (no internet needed)&#xa;✓ Distributes computation&#xa;&#xa;Cons:&#xa;✗ Duplicate rule logic on each edge device&#xa;✗ Harder to update rules (need redeploy to devices)&#xa;✗ More complex edge code" vertex="1">
          <mxGeometry height="280" width="380" x="380" y="285" as="geometry" />
        </mxCell>

        <!-- OPTION B: SERVER VIOLATION ENGINE (CURRENT POC) -->
        <mxCell id="option-b-title" parent="1" style="text;fontSize=11;fontStyle=1;align=left;fillColor=#a5d6a7;strokeColor=#388e3c;rounded=1;padding=8" value="OPTION B: Server-Side Violation Engine (✅ Current POC Choice)" vertex="1">
          <mxGeometry height="25" width="380" x="800" y="250" as="geometry" />
        </mxCell>

        <mxCell id="option-b-box" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e8f5e9;strokeColor=#388e3c;fontSize=8;align=left;padding=8" value="WHEN: Server receives event via POST&#xa;WHERE: server/app.py:check_violation_rules()&#xa;&#xa;Models created on SERVER:&#xa;✅ VIOLATION model (aggregated)&#xa;   └─ Count events: 3 drowsy in 2 min?&#xa;   └─ Trigger rule, create violation&#xa;✅ EVIDENCE model (JPG capture)&#xa;   └─ Frame JPG is in EVENT (optional)&#xa;   └─ Embed in violation object on server&#xa;✅ ALARM model&#xa;   └─ Create message: &quot;DROWSINESS DETECTED&quot;&#xa;&#xa;Flow (Edge → Server):&#xa;Event (POST) → Server checks rules → Violation (+ JPG)&#xa;     ↓&#xa;     WebSocket /violations/stream&#xa;     ↓&#xa;     Dashboard displays&#xa;&#xa;Pros:&#xa;✓ Simple edge code (just emit events)&#xa;✓ Centralized rules (1 rule engine)&#xa;✓ Easy to update rules (no redeploy)&#xa;✓ Good for demo (clear flow)&#xa;&#xa;Cons:&#xa;✗ Higher latency (network round-trip)&#xa;✗ Requires internet/server&#xa;✗ Server becomes bottleneck" vertex="1">
          <mxGeometry height="280" width="380" x="800" y="285" as="geometry" />
        </mxCell>

        <!-- EVIDENCE CAPTURE TIMING -->
        <mxCell id="evidence-timing" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff9c4;strokeColor=#f57f17;fontSize=8;align=left;padding=8" value="JPG EVIDENCE CAPTURE TIMING:&#xa;&#xa;Edge Option:&#xa;Frame → Threshold → Event → Violation&#xa;                      ↓ (capture JPG here)&#xa;                   Embed in violation&#xa;&#xa;Server Option:&#xa;Frame → Threshold → Event (send to server)&#xa;                           ↓&#xa;                      Violation (capture JPG here, optional)&#xa;                           ↓&#xa;                      Embed in violation&#xa;&#xa;For POC: JPG embedded in violation on server side&#xa;(captures frame at violation moment, not event moment)" vertex="1">
          <mxGeometry height="160" width="500" x="50" y="605" as="geometry" />
        </mxCell>

      </root>
    </mxGraphModel>
  </diagram>

</mxfile>
