        <mxCell id="event-model" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f3e5f5;strokeColor=#6a1b9a;fontSize=8;align=left;padding=5;fontFamily=monospace" value="EVENT (Edge → Server)&#xa;{&#xa;  type: DROWSINESS,&#xa;  ear: 0.18,&#xa;  duration: 0.75s,&#xa;  timestamp: unix,&#xa;  confidence: 0.95&#xa;}" vertex="1">
